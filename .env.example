# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max
# 回退模型须在同网关可用；为空可关闭。单独声明其真实窗口，避免沿用主模型容量。
# LLM_FALLBACK_MODEL=qwen-plus
# LLM_FALLBACK_CONTEXT_SIZE=128000
# 可选公开 Thinking：未设置/留空不发送参数，保持供应商默认；1/true 开启，0/false 关闭。
# 主模型和回退模型都须支持 enable_thinking；不自动更换模型，修改后重启 API/worker。
# LLM_ENABLE_THINKING=1

# ===== 模型目录与自定义连接 =====
# configs/models.yaml 定义当前部署迁移模板；页面配置保存到 DATA_DIR/models.sqlite3。
# MODEL_MASTER_KEY 为 Fernet 格式主密钥，仅通过服务端 Secret 注入，绝不放入 VITE_*。
# 未设置则自动生成 DATA_DIR/.secrets/model_registry.key；备份/恢复须保留原密钥。
# 直接更换主密钥无法解密已有凭据，不是轮换流程。
# MODEL_MASTER_KEY=
# 远端签名身份管理员，逗号分隔；demo 模式仅允许本机同源管理。
MODEL_ADMIN_BUYERS=
# 私有/本地模型服务需显式放行精确主机名或 IP；不是 URL，不允许通配。
# 仅当确实需要访问本机模型时填写，例如 localhost,127.0.0.1。
MODEL_ALLOWED_LOCAL_HOSTS=

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=voyacart_products

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# RERANKER_BASE_URL=https://your-reranker-host
# http：只调用专用精排接口；disabled：关闭。无 LLM 精排回退。
RERANKER_MODE=http
# 必须使用服务实际开通的模型 ID，不能用聊天模型名代替。
RERANKER_MODEL=qwen-text-rerank
# RERANKER_API_KEY=   # 空时复用 LLM_API_KEY，同一网关才应复用
RERANKER_PROTOCOL=flat
RERANKER_TIMEOUT_SECONDS=15
# DashScope 原生协议使用服务商给出的完整接口地址，protocol=dashscope
# qwen-text-rerank 是本项目指定的网关模型 ID；须在该网关开通，不能当作其它提供商的别名。

# Hybrid 代码已可用；冻结评测未证明在线收益，默认保留当前主链。
HYBRID_RECALL_ENABLED=0
HYBRID_LEXICAL_WEIGHT=1
HYBRID_VECTOR_WEIGHT=1
RECALL_CANDIDATES=32

# ===== 上下文预算（token 单位） =====
# 当前网关的声明最大窗口；页面只能在对应模型能力范围内选择 local_budget。
# 本地上限不会扩大供应商窗口，也不等于 Harness 工作目标。
CONTEXT_SIZE=128000
TOOL_RESULT_LIMIT=20000
# 完整摘要计量的上下文专项通过；回滚改回 legacy 并重启 API/worker。
CONTEXT_STRATEGY=layered
# 开发集选定 pressure：成功读取后且出现压力时裁剪，保护完整近期轮次。
CONTEXT_PRUNING_TIMING=pressure
CONTEXT_PRODUCT_TOKENS=6000
CONTEXT_TARGET_TOKENS=48000
# 以下组合仅作候选验证；收益门禁通过后再在本机启用，默认不改变现有策略。
# stable_prefix 同时要求 Skill 目录按变化追加，工厂会使用 append_only。
# CONTEXT_PROMPT_LAYOUT=stable_prefix
# CONTEXT_SUMMARY_MODE=preserve_prefix
# MODEL_RECOVERY_MODE=bounded
# 回滚：legacy_system / native / off；原始证据和会话数据库无需删除。
TOKEN_BUDGET_TOTAL=0
# 非零启用调用前保守预留、实际usage结算；不足时规则回复不再调模型。

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic%20<base64-public-key-colon-secret-key>,x-langfuse-ingestion-version=4
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5
# OTEL_SERVICE_NAME=voyacart-agent
# 无显式 OTLP 端点时，以下三项自动启用 Langfuse Basic Auth 与 v4 摄取。
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-你的项目公钥
# LANGFUSE_SECRET_KEY=sk-lf-你的项目私钥
# Langfuse 配置与脱敏边界见 docs/Langfuse与端到端Trace.md；真实密钥仅注入本地环境。
# 默认演示身份是客户端声明，不是登录；持久 session owner 绑定默认开启。
IDENTITY_MODE=demo
SESSION_OWNER_BINDING=1
# 仅隔离成对评测固定已导入版本；常规运行留空，按发布记录和买家分组。
PROMPT_PIN_VERSION=
# 全进程运维指标只给明确的签名主体；空值关闭，启用还须 IDENTITY_MODE=hmac。
METRICS_READER_BUYERS=
# 严格模式设 IDENTITY_MODE=hmac；密钥至少 32 字节，只保存在服务端环境。
# IDENTITY_HMAC_SECRET=
# 浏览器只接收维护者运行时提供的短期 token；禁止 VITE_API_TOKEN。
# 公网部署显式开启后，启动校验严格身份、HTTPS Origin、正值预算与请求速率。
PUBLIC_DEPLOYMENT=0
HTTP_MAX_REQUEST_BYTES=1048576
HTTP_BODY_TIMEOUT_SECONDS=30
# 每 API 进程每分钟总请求额；0 仅供私有演示。不是集群或 run 准入。
HTTP_REQUESTS_PER_MINUTE=0
# 公网必须显式设置；不要配置通配符或带路径的 URL。
# CORS_ORIGINS=https://your-demo.example
# Compose 私有默认允许 localhost:5173 和 127.0.0.1:5173；自定义值传给全部 API/worker。
# PUBLIC_DEPLOYMENT=1 只启用启动护栏，不创建 TLS、认证入口或公网监听。

# 长期记忆默认使用 LLM 提炼 + 当前 EMBEDDING_* 建立持久向量；保存失败不回退原文。
# 权威库为 DATA_DIR/buyer_memory.db，每位买家最多 200 条。
# 正向语义召回数量；dislike 硬约束全量保留。
PREFERENCE_TOP_K=5
# 旧 PREFERENCE_RELEVANCE_ENABLED 仅影响旧 PreferenceSelector，新记忆默认语义召回。

# Skill 目录候选：append_only 按变化追加；收益门禁通过前保留 legacy。
SKILL_CATALOG_MODE=legacy
# 学习发件箱：开启仅持久化终态引用；提炼需离线 worker，发布需人工审核，不启动训练。
LEARNING_CAPTURE_ENABLED=0

# 自动化调度：embedded 随单进程后端启动；external 使用独立 Worker；off 停止调度。
# 本地嵌入式 Qdrant 只能用 embedded；external 需配置 QDRANT_URL 并共享持久数据。
AUTOMATION_WORKER_MODE=embedded

# AG-UI 可选入队：需要 QUEUE_ENABLED=1 与 REDIS_URL；满载返回 503。
AGUI_QUEUE_ENABLED=0
AGUI_QUEUE_MAX_PENDING=200
# 两个旧 intents 入口也服从此队列上限；超限/Redis故障返回503，不自动本地执行。
QUEUE_MAX_AGE_SECONDS=900
# 每进程运行上限与整轮期限；多进程总量为各进程之和，不是容量实测承诺。
RUN_MAX_ACTIVE=8
RUN_TIMEOUT_SECONDS=300
# Compose 单容器资源保护值未经容量验收：API/worker/Qdrant 2 CPU/2 GiB/256 PID；
# Redis 1 CPU/512 MiB/64 PID（maxmemory 256 MiB、noeviction）；前端 0.5 CPU/128 MiB/64 PID。
# scale mock 为 1 CPU/256 MiB/64 PID。json-file 每容器 10 MiB × 3 轮转，非数据卷配额。
# 多副本资源与 RUN_MAX_ACTIVE 总量相加；满内存拒绝写入/容器 OOM 须运维监测。
# 这些是 Compose 文件的显式默认值，调整须通过经检查的 override，不是上述 env 参数。
# 0 保持原始增量；多实例部署可以显式设为 50。
AGUI_DELTA_COALESCE_MS=0
# 多进程工具顺序断言；历史存入会话库，默认沿用进程内记录。
SEQUENCING_PERSISTENCE_ENABLED=0

# 本地多语种向量兜底：先安装 retrieval 依赖并准备模型缓存，再显式开启。
LOCAL_EMBEDDING_FALLBACK=0
QDRANT_LOCAL_COLLECTION=voyacart_products_local
